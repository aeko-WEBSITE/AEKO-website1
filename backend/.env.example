# Copy to .env and fill in values. Do not commit .env.

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/yourdb

# Auth
JWT_SECRET=your_jwt_secret_at_least_32_chars

# ModelsLab Text2Video (required for video generation)
MODELSLAB_API_KEY=your_modelslab_api_key

# Optional
PORT=5000
NODE_ENV=development
