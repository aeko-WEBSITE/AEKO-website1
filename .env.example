# MAIN BACKEND URL (required for payment, auth, packages).
# - Development: leave empty to use Vite proxy to localhost:5000, OR set:
#   VITE_API_URL=http://localhost:5000
# - Production: set to your deployed backend, e.g. https://your-backend.onrender.com
#
# DO NOT set this to https://demo.liquidata.dev — that is only for the LLM
# provider (chat) and does not handle payment, auth, or packages.
#
# VITE_API_URL=

# Razorpay (public key for checkout)
# VITE_RAZORPAY_KEY_ID=
