# MAIN BACKEND URL (required for payment, auth, packages).
# - Development: leave empty to use Vite proxy to localhost:5000, OR set:
#   VITE_API_URL=http://localhost:5000
# - Production: set to your deployed backend, e.g. https://your-backend.onrender.com
#
# DO NOT set this to https://demo.liquidata.dev — that is only for the LLM
# provider (chat) and does not handle payment, auth, or packages.
#
# VITE_API_URL=

# --- Admin ---
# Admin uses the same backend as the rest of the app (VITE_API_URL above).
# Admin login: POST /admin/auth/login with a user that has role "admin".
# No extra env vars needed for admin; ensure backend is running and VITE_API_URL points to it.

# Razorpay (public key for checkout)
# VITE_RAZORPAY_KEY_ID=

# Google Sign-In (optional)
# VITE_GOOGLE_CLIENT_ID=

# Sarvam voice/chat (optional, for agent voice)
# VITE_SARVAM_CHAT_URL=

# Apimodule / demo server (optional)
# VITE_APIMODULE_URL=
